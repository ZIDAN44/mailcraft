# The FileManager-Actions menu for files (PCManFM-Qt and LXQt; Caja with caja-actions): Send with
# MailCraft, a new message with them attached (issue #96, `--attach` in
# apps/mailcraft/src/startup/args.rs). Installed as
# /usr/share/file-manager/actions/io.github.zidan44.MailCraft.desktop (packaging/linux/package.sh).
# Kept out of packaging/linux/*.desktop: it's an action, not an app's desktop entry.
# all/allfiles is every file, and no folder.
[Desktop Entry]
Type=Action
Name=Send with MailCraft
Name[ar]=إرسال عبر MailCraft
Name[de]=Mit MailCraft senden
Name[es]=Enviar con MailCraft
Name[fr]=Envoyer avec MailCraft
Name[he]=שליחה באמצעות MailCraft
Name[it]=Invia con MailCraft
Name[ja]=MailCraft で送信
Name[ko]=MailCraft로 보내기
Name[nl]=Verzenden met MailCraft
Name[pt_BR]=Enviar com o MailCraft
Name[ru]=Отправить через MailCraft
Name[tr]=MailCraft ile gönder
Name[zh_CN]=使用 MailCraft 发送
Name[zh_TW]=使用 MailCraft 傳送
Icon=io.github.zidan44.MailCraft
Profiles=files;

[X-Action-Profile files]
MimeTypes=all/allfiles;
SelectionCount=>0
Exec=mailcraft --attach %F
