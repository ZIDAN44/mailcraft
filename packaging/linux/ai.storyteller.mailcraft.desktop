[Desktop Entry]
Type=Application
Name=MailCraft
GenericName=Email
Comment=Read, write and organise your email
Exec=mailcraft %U
TryExec=mailcraft
Icon=ai.storyteller.mailcraft
Terminal=false
# winit doesn't finish the desktop's start-up notification, which left a busy cursor until it
# timed out (as PhotoCraft's entry).
StartupNotify=false
StartupWMClass=ai.storyteller.mailcraft
Categories=Network;Email;Office;
Keywords=email;mail;e-mail;imap;smtp;inbox;outlook;
# Offered as the mail app (mailto: links) and for mail, calendar and contact files; the desktop's
# settings make it the default. %U hands them over as links (apps/mailcraft/src/args.rs).
MimeType=x-scheme-handler/mailto;message/rfc822;application/vnd.ms-outlook;text/calendar;text/vcard;text/x-vcard;text/directory;
