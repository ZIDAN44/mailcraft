<?xml version="1.0" encoding="utf-8"?>
<!--
  MailCraft MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build mailcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, and mailcraft.exe on the App
  Paths list (so Win+R `mailcraft` starts it), and MailCraft offered as the mail app and for
  .eml, .ics and .vcf files (MailcraftDefaultApp, below).

  UpgradeCode is fixed for MailCraft forever (playbook §6); never change it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="MailCraft"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="F1EC42C6-A525-406B-878C-789DC52E1958"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="MailCraft email" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of MailCraft is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Windows 10 or later: the Rust standard library has needed it since 1.78 (on Windows 7 and
         8 the app fails at launch: "The procedure entry point ProcessPrng could not be located in
         bcryptprimitives.dll"), and MailCraft draws with DirectX 12. The installer says so rather
         than installing an app that can't start. `CurrentMajorVersionNumber` exists only from
         Windows 10 on, in the 32- and 64-bit registry views alike; MSI's own VersionNT has
         reported both 603 and 1000 there (as PhotoCraft found). `Installed` keeps repair and
         uninstall working on any Windows. -->
    <Property Id="WINDOWS10ORLATER" Secure="yes">
      <RegistrySearch Id="WindowsMajorVersion" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
          Name="CurrentMajorVersionNumber" Type="raw" />
    </Property>
    <Launch Condition="Installed OR WINDOWS10ORLATER" Message="MailCraft needs Windows 10 or later." />

    <Icon Id="MailcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="MailcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/ZIDAN44/mailcraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/ZIDAN44/mailcraft/releases" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/artcraft" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="MailCraft" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="MailCraft" Level="1">
      <ComponentGroupRef Id="MailcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="MailcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="MailcraftApp" Guid="91B16AB2-5D6F-482D-B2D4-9886A392A893">
        <File Id="MailcraftExe" Source="$(var.BinDir)\mailcraft.exe" KeyPath="yes">
          <!-- No Icon here: the shortcut shows the icon embedded in mailcraft.exe (build.rs). An
               MSI Icon is cached under %APPDATA%\Microsoft\Installer\{ProductCode}\, and every
               update is a major upgrade with a new ProductCode that deletes the old folder; a
               taskbar pin is a copy of this shortcut the update never touches, so it pointed at the
               deleted file and lost its icon (DeckCraft found this). Not advertised, so it targets
               the exe, whose path survives updates. The Icon above stays for ARPPRODUCTICON. -->
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="MailCraft"
              Description="MailCraft email" WorkingDirectory="INSTALLFOLDER" Advertise="no">
            <!-- The app id MailCraft's notifications are shown under (apps/mailcraft/src/toast.rs). -->
            <ShortcutProperty Key="System.AppUserModel.ID" Value="ai.storyteller.mailcraft" />
          </Shortcut>
        </File>
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\mailcraft.exe" Value="[#MailcraftExe]" Type="string" />
      </Component>

      <!-- Lets Windows offer MailCraft as a mail program. Nothing here makes it the default:
           the Capabilities key puts it on the list in Settings > Apps > Default apps (under Email
           and the .eml, .ics and .vcf types) for the user to choose, and each extension's
           OpenWithProgids entry adds it to Explorer's "Open with" menu. A link or a file path is
           passed as the one argument (apps/mailcraft/src/args.rs). Uninstalling removes it all. -->
      <Component Id="MailcraftDefaultApp" Guid="B74ACD47-7B2E-4DEA-8113-42A3B3D00FDE">
        <RegistryKey Root="HKLM" Key="Software\RegisteredApplications">
          <RegistryValue Name="MailCraft" Type="string" Value="Software\MailCraft\Capabilities" KeyPath="yes" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\MailCraft\Capabilities">
          <RegistryValue Name="ApplicationName" Type="string" Value="MailCraft" />
          <RegistryValue Name="ApplicationDescription" Type="string" Value="Local-first email client for IMAP and SMTP accounts, with calendar invitations and contact cards." />
          <RegistryValue Name="ApplicationIcon" Type="string" Value="&quot;[#MailcraftExe]&quot;,0" />
          <RegistryKey Key="URLAssociations">
            <RegistryValue Name="mailto" Type="string" Value="MailCraft.mailto" />
          </RegistryKey>
          <RegistryKey Key="FileAssociations">
            <RegistryValue Name=".eml" Type="string" Value="MailCraft.eml" />
            <RegistryValue Name=".ics" Type="string" Value="MailCraft.ics" />
            <RegistryValue Name=".vcf" Type="string" Value="MailCraft.vcf" />
          </RegistryKey>
        </RegistryKey>

        <!-- The program entry itself: its display name, its open command, the types it accepts. -->
        <RegistryKey Root="HKLM" Key="Software\Classes\Applications\mailcraft.exe">
          <RegistryValue Name="FriendlyAppName" Type="string" Value="MailCraft" />
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[#MailcraftExe]&quot; &quot;%1&quot;" />
          </RegistryKey>
          <RegistryKey Key="SupportedTypes">
            <RegistryValue Name=".eml" Type="string" Value="" />
            <RegistryValue Name=".ics" Type="string" Value="" />
            <RegistryValue Name=".vcf" Type="string" Value="" />
          </RegistryKey>
        </RegistryKey>

        <!-- mailto: links -->
        <RegistryKey Root="HKLM" Key="Software\Classes\MailCraft.mailto">
          <RegistryValue Type="string" Value="URL:mailto (MailCraft)" />
          <RegistryValue Name="URL Protocol" Type="string" Value="" />
          <RegistryValue Name="FriendlyTypeName" Type="string" Value="Email address link (MailCraft)" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="&quot;[#MailcraftExe]&quot;,0" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[#MailcraftExe]&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>

        <!-- .eml -->
        <RegistryKey Root="HKLM" Key="Software\Classes\MailCraft.eml">
          <RegistryValue Type="string" Value="Saved email message" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="&quot;[#MailcraftExe]&quot;,0" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[#MailcraftExe]&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.eml\OpenWithProgids">
          <RegistryValue Name="MailCraft.eml" Type="string" Value="" />
        </RegistryKey>

        <!-- .ics -->
        <RegistryKey Root="HKLM" Key="Software\Classes\MailCraft.ics">
          <RegistryValue Type="string" Value="iCalendar events" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="&quot;[#MailcraftExe]&quot;,0" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[#MailcraftExe]&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.ics\OpenWithProgids">
          <RegistryValue Name="MailCraft.ics" Type="string" Value="" />
        </RegistryKey>

        <!-- .vcf -->
        <RegistryKey Root="HKLM" Key="Software\Classes\MailCraft.vcf">
          <RegistryValue Type="string" Value="vCard contacts" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="&quot;[#MailcraftExe]&quot;,0" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[#MailcraftExe]&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.vcf\OpenWithProgids">
          <RegistryValue Name="MailCraft.vcf" Type="string" Value="" />
        </RegistryKey>
      </Component>

      <Component Id="MailcraftCli">
        <File Id="MailcraftCliExe" Source="$(var.BinDir)\mailcraft-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
