<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.2.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <!-- The interface's languages (its catalogs are compiled in, crates/ui-egui/src/i18n/), named
       for AppKit so its own dialogs (open and save panels, the overwrite question) speak them too;
       without this they stayed English. Kept in step with the catalogs by a test. -->
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>ar</string>
    <string>de</string>
    <string>es</string>
    <string>fr</string>
    <string>he</string>
    <string>it</string>
    <string>ja</string>
    <string>ko</string>
    <string>nl</string>
    <string>pt-BR</string>
    <string>ru</string>
    <string>zh-Hans</string>
    <string>zh-Hant</string>
  </array>
  <key>CFBundleDisplayName</key>
  <string>MailCraft</string>
  <key>CFBundleName</key>
  <string>MailCraft</string>
  <key>CFBundleExecutable</key>
  <string>MailCraft</string>
  <key>CFBundleIdentifier</key>
  <string>ai.storyteller.mailcraft</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>MailCraftVersion</key>
  <string>@VERSION@</string>
  <key>MailCraftBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>MailCraft</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.productivity</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © the MailCraft authors. MIT OR Apache-2.0.</string>

  <!-- Documents MailCraft can be asked to open. Rank Alternate: it shows up in Open With and
       can be picked as the default in Get Info, but never takes a type over by itself. A saved
       message opens for reading; events and contacts are imported. macOS delivers them through
       an Apple event that apps/mailcraft/src/apple_events.rs reads.

       There is deliberately no CFBundleURLTypes entry for mailto. Links arrive as a different
       Apple event that MailCraft has no safe way to receive yet, so registering the scheme would
       start the app and drop the address. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>MailCraft saved message</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.email-message</string>
        <string>com.apple.mail.email</string>
      </array>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>MailCraft iCalendar file</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.calendar-event</string>
        <string>com.apple.ical.ics</string>
      </array>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>MailCraft vCard file</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.vcard</string>
      </array>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
    </dict>
  </array>
</dict>
</plist>
