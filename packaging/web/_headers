# Netlify / Cloudflare Pages header rules (see HOSTING.md). Other hosts: set the same headers.
/*
  X-Content-Type-Options: nosniff

/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

# The Simplified Chinese font, fetched only when it's wanted: kept once it's come.
/fonts/*.otf
  Content-Type: font/otf
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache
