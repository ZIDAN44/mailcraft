# What an export keeps in an item's text (a card's or a to-do's lines between BEGIN and END) and
# the parts of a rule a task's recurrence pattern says.
"BEGIN:VCARD"
"END:VCARD"
"BEGIN:VTODO"
"END:VTODO"
"\x0a"
"\x0d\x0a"
"EMAIL;TYPE=work:"
"TEL;TYPE=cell:"
"ADR;TYPE=home:"
"BDAY:--"
"URL:"
"PHOTO:data:image/png;base64,"
"RRULE:"
"FREQ=DAILY"
"FREQ=WEEKLY"
"FREQ=MONTHLY"
"FREQ=YEARLY"
";INTERVAL="
";COUNT="
";UNTIL="
";BYDAY="
";BYMONTHDAY="
";BYMONTH="
";WKST=SU"
"-1FR"
"1TU"
"MO,TU,WE,TH,FR"
